<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-1" author="gov_architect">
        <createTable tableName="petition_signatures">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="petition_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="citizen_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="signed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="signature_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="petition_signatures"
                             columnNames="petition_id, citizen_id"
                             constraintName="uk_petition_signatures_petition_citizen"/>

        <addForeignKeyConstraint baseTableName="petition_signatures"
                                 baseColumnNames="petition_id"
                                 constraintName="fk_petition_signatures_petition"
                                 referencedTableName="petitions"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="petition_signatures"
                                 baseColumnNames="citizen_id"
                                 constraintName="fk_petition_signatures_citizen"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
